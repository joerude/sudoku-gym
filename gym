#!/usr/bin/env bash
# Sudoku Gym launcher: ./gym <command>. Run ./gym help for the list.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

PORT="${PORT:-8765}"          # docker-compose.yml publishes 8765; PORT only changes `dev`
URL="http://127.0.0.1:${PORT}/"
HEALTH="${URL}api/health"
DB=data/sudoku.db
BACKUP_DIR="${BACKUP_DIR:-data/backups}"
KEEP="${KEEP:-20}"          # backups kept; older ones are deleted

say() { printf '\033[1m%s\033[0m\n' "$*"; }
die() { printf 'ошибка: %s\n' "$*" >&2; exit 1; }

healthy() { curl -sf --max-time 2 "$HEALTH" >/dev/null 2>&1; }

# Wait until the server answers; the first start imports the puzzle bank, which takes a couple of minutes.
wait_ready() {
  local limit="${1:-300}" waited=0
  printf 'жду сервер'
  until healthy; do
    if (( waited >= limit )); then
      printf '\n'
      die "сервер не ответил за ${limit} с — смотри ./gym logs"
    fi
    printf '.'; sleep 2; waited=$((waited + 2))
  done
  printf ' готов: %s\n' "$(curl -sf "$HEALTH")"
}

open_browser() {
  [[ "${NO_OPEN:-0}" == 1 ]] && return 0
  if command -v xdg-open >/dev/null; then xdg-open "$URL" >/dev/null 2>&1 &
  elif command -v open >/dev/null; then open "$URL"
  else say "открой $URL"
  fi
}

need_docker() { command -v docker >/dev/null || die "нужен Docker (или запусти без него: ./gym dev)"; }

# Consistent copy of the progress DB (safe while the server runs), then keep the newest $KEEP.
backup() {
  [[ -f "$DB" ]] || { say "бэкап пропущен: нет $DB"; return 0; }
  mkdir -p "$BACKUP_DIR"
  local out="$BACKUP_DIR/sudoku-$(date +%Y-%m-%d_%H%M%S).db"
  [[ -e "$out" ]] && return 0  # one per second is plenty
  python3 -c 'import sqlite3, sys; sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True).execute("VACUUM INTO ?", (sys.argv[2],))' "$DB" "$out"
  ls -1t "$BACKUP_DIR"/sudoku-*.db | tail -n +"$((KEEP + 1))" | xargs -r rm --
  say "бэкап: $out"
}

pre_commit() {
  if command -v pre-commit >/dev/null; then pre-commit "$@"
  elif command -v uvx >/dev/null; then uvx pre-commit "$@"
  else die "нужен pre-commit (pipx install pre-commit) или uv"
  fi
}

# node for the e2e suite: PATH first, then the newest nvm install
find_node() {
  command -v node 2>/dev/null && return 0
  ls -d "$HOME"/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  start)
    need_docker
    backup
    say "сборка и запуск контейнера…"
    docker compose up -d --build
    wait_ready
    open_browser
    say "Sudoku Gym: $URL"
    ;;
  stop)
    need_docker
    docker compose stop
    ;;
  restart)
    need_docker
    backup
    docker compose up -d --build --force-recreate
    wait_ready
    ;;
  status)
    if healthy; then say "работает: $URL"; curl -sf "$HEALTH"; echo
    else say "не отвечает на $URL"; fi
    command -v docker >/dev/null && docker compose ps
    ;;
  logs)
    need_docker
    docker compose logs -f --tail "${1:-50}"
    ;;
  open)
    healthy || die "сервер не запущен — ./gym start"
    NO_OPEN=0 open_browser
    ;;
  dev)
    # without Docker, straight from the working tree (code changes apply on a page reload)
    command -v python3 >/dev/null || die "нужен python3"
    if healthy; then die "порт $PORT уже занят (контейнер?) — ./gym stop или PORT=8766 ./gym dev"; fi
    backup
    python3 tools/import_bank.py --if-empty
    ( sleep 1; wait_ready 30 >/dev/null && open_browser ) &
    say "Sudoku Gym (без Docker): $URL — Ctrl+C, чтобы остановить"
    exec python3 server.py --port "$PORT"
    ;;
  test)
    say "юнит-тесты"
    python3 -m unittest discover -s tests
    node_bin="$(find_node || true)"
    if [[ -z "$node_bin" ]]; then say "e2e пропущены: нет node"; exit 0; fi
    say "e2e (${BROWSER:-chromium})"
    set +e
    "$node_bin" tests/e2e/gym.spec.mjs "$@"
    code=$?
    set -e
    if (( code == 2 )); then say "e2e пропущены: нет playwright-core (задай PLAYWRIGHT_CORE)"; exit 0; fi
    exit "$code"
    ;;
  backup)
    backup
    ;;
  setup)
    pre_commit install
    ;;
  check)
    pre_commit run --all-files
    ;;
  help|-h|--help)
    cat <<'EOF'
./gym start     собрать и поднять контейнер, дождаться сервера, открыть браузер
./gym stop      остановить контейнер (прогресс в data/ сохраняется)
./gym restart   пересобрать и перезапустить (после правок кода)
./gym status    жив ли сервер, сколько задач в базе
./gym logs [N]  логи контейнера (последние N строк и дальше в реальном времени)
./gym open      открыть тренажёр в браузере
./gym dev       запустить без Docker из рабочей папки (PORT=8766 — другой порт)
./gym test      юнит-тесты и e2e (BROWSER=firefox — в Firefox)
./gym backup    копия базы прогресса в data/backups/ (делается и перед start/restart/dev)
./gym setup     поставить git-хуки (pre-commit: ruff, тесты, проверка сообщения коммита)
./gym check     прогнать хуки по всем файлам: ruff lint + format, гигиена файлов, тесты

NO_OPEN=1 — не открывать браузер. BACKUP_DIR=… KEEP=20 — куда и сколько бэкапов хранить.
EOF
    ;;
  *)
    die "неизвестная команда «$cmd» — ./gym help"
    ;;
esac
